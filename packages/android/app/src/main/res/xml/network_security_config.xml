<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic only for localhost in debug builds -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>  <!-- Android emulator localhost -->
    </domain-config>
    
    <!-- All other domains require HTTPS in production -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.nova.app</domain>
    </domain-config>
</network-security-config>
